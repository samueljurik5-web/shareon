# ───────────── ShareOn – environment variables ─────────────
# Copy to server/.env for local development (cp .env.example server/.env)
# and/or to ./.env for docker compose.

NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL="postgresql://shareon:shareon@localhost:5432/shareon?schema=public"
# Used by `npm test` – a SEPARATE database; tests truncate all its tables.
TEST_DATABASE_URL="postgresql://shareon:shareon@localhost:5432/shareon_test?schema=public"
POSTGRES_PASSWORD=shareon

# Auth – generate with: openssl rand -hex 32  (min. 32 chars).
# The server refuses to start in production with a value starting with "dev-only".
JWT_SECRET="dev-only-change-me-0123456789abcdef0123456789abcdef"
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Uploads (local disk in development; see services/storage for S3/Cloudinary extension point)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
RATE_LIMIT_ENABLED=true

# Payments – only "mock" (SIMULATED PAYMENT) exists in the MVP.
PAYMENT_PROVIDER=mock

# Real insurance – leave EMPTY. INSURANCE mode is rejected unless ALL of these are set,
# backed by a real insurance partner contract and legally reviewed terms.
INSURANCE_PROVIDER_NAME=
INSURANCE_CONTRACT_REFERENCE=
INSURANCE_TERMS_URL=
INSURANCE_LEGAL_REVIEW_APPROVED=false

# Client (optional) – API base URL when the client is NOT served behind the same origin/proxy
# VITE_API_URL=http://localhost:4000

# ───────────── Development seed credentials (CHANGE/REMOVE BEFORE PRODUCTION) ─────────────
